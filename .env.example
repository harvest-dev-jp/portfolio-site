# Email Service Configuration
# Choose one of: sendgrid, mailgun, resend, or custom
NEXT_PUBLIC_EMAIL_SERVICE=sendgrid
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# SendGrid Configuration (if using SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Mailgun Configuration (if using Mailgun)
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_domain_here

# Resend Configuration (if using Resend)
RESEND_API_KEY=your_resend_api_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/harvest-dev-jp
